rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users/{uid}/activity/{id}: server-owned trigger and submission records.
    // nonces/{hash}: server-owned, one-use launch authorization records.
    // All access goes through authenticated Functions using the Admin SDK.
    // Client SDK reads and writes are intentionally denied for every path.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
