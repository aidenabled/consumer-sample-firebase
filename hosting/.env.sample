# Local defaults work without a Firebase account. Never use demo IDs in production.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-consumer-sample
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-consumer-sample.firebaseapp.com
# Set these from your Firebase web app config for deployment.
VITE_FIREBASE_APP_ID=
