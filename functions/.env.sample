# AiDEN's Base64-encoded DER/SPKI RSA public key for signed launches.
# Supply the public key for your own AiDEN integration.
AIDEN_PUBLIC_KEY=
# Your AiDEN consumer API origin and account username.
AIDEN_URL=https://YOUR_AIDEN_API_HOST
AIDEN_USERNAME=
# Public HTTPS origin of this Firebase service. Notifications open /authorize.
SERVICE_URL=https://YOUR_PROJECT_ID.web.app
NOTIFICATION_TITLE=Your service is ready
NOTIFICATION_MESSAGE=Your vehicle is parked. Open your service to see the latest update.
